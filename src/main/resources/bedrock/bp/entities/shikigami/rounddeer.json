{
  "format_version": "1.13.0",
  "minecraft:entity": {
    "description": {
      "identifier": "ds:rounddeer",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
    "ds:disappear": { "minecraft:transformation": {
          "into": "ds:disappear",
          "delay": 0.0
        }},
    "sukuna_clan": {
          "minecraft:type_family": {
            "family": ["monster", "rounddeer", "shikigami", "pureshikigami", "10s_shikigami", "tamed", "familiar", "sukuna_clan"]
          }
       },
       "rogue_sorcerer_clan": {
          "minecraft:type_family": {
            "family": ["monster", "rounddeer", "shikigami", "pureshikigami", "10s_shikigami", "tamed", "familiar", "rogue_sorcerer_clan"]
          }
       },
       "sorcerer_clan": {
          "minecraft:type_family": {
            "family": ["monster", "rounddeer", "shikigami", "pureshikigami", "10s_shikigami", "tamed", "familiar", "sorcerer_clan"]
          }
       }
    },
    "components": {
      "minecraft:nameable": {
      },
      "minecraft:type_family": {
        "family": ["monster", "rounddeer", "shikigami", "pureshikigami", "10s_shikigami", "tamed", "familiar"]
      },
      "minecraft:collision_box": {
        "width": 1.4,
        "height": 1.4
      },
      "minecraft:movement.basic": {
      },
      "minecraft:navigation.walk": {
        "is_amphibious": false,
        "can_sink": true,
        "can_swim": false,
        "can_walk": true,
        "can_open_doors": false,
        "can_pass_doors": true,
        "can_break_doors": false,
        "avoid_portals": true,
        "avoid_damage_blocks": true,
        "can_path_over_water": false
      },
      "minecraft:annotation.break_door": {
      },
      "minecraft:jump.static": {
      },
      "minecraft:can_climb": {
      },
      "minecraft:health": {
        "value": 50,
        "max": 50
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:movement": {
          "value": 0.2
      },
        "minecraft:scale": {
          "value": 1.5
      },
      "minecraft:knockback_resistance": {
        "value": 15
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/sus"
      },
      "minecraft:is_tamed": {},
      "minecraft:behavior.float": {
        "priority": 0
      },
"minecraft:behavior.teleport_to_owner": {
  "priority": 0,
  "filters": {
    "all_of": [
    {
    "test": "owner_distance",
    "operator": ">",
    "value": 30
    }
    ]
  }
},
      "minecraft:behavior.follow_owner": {
          "priority": 6,
          "speed_multiplier": 1.0,
          "start_distance": 12,
          "stop_distance": 2
        },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 1
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
			},
      "minecraft:follow_range": 128,
      "minecraft:loot": {
        "table": "loot/nothing.json"
      },
      "minecraft:physics": {
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:damage_sensor": { "triggers": [
            { "on_damage": { "filters": { "all_of": [ { "test": "has_tag", "subject": "self", "operator": "==", "value": "Frames" }, { "any_of": [ { "test": "has_damage", "subject": "self", "operator": "!=", "value": "suicide" }, { "test": "has_damage", "subject": "self", "operator": "!=", "value": "override" }, { "test": "has_damage", "subject": "self", "operator": "!=", "value": "starve" }, { "test": "has_damage", "subject": "self", "operator": "!=", "value": "void" } ] } ] } }, "deals_damage": false },
            { "on_damage": { "filters": { "all_of": [ { "test": "is_owner", "subject": "damager", "value": true, "operator": "==" } ] } }, "cause": "all", "deals_damage": false },
            { "on_damage": { "filters": { "all_of": [ { "test": "actor_health", "subject": "self", "operator": "<=", "value": 0 } ] }, "event": "familiar_die" }, "cause": "all", "deals_damage": false }
            ] }
    },
    "events": {
      "familiar_spawn_sorcerer": {
                        "add": {"component_groups": ["sorcerer_clan"]}
            },
            "familiar_spawn_rogue": {
                        "add": {"component_groups": ["rogue_sorcerer_clan"]}
            },
            "familiar_spawn_sukuna": {
                        "add": {"component_groups": ["sukuna_clan"]}
            },
      "familiar_die": {
        "sequence": [
            {
                "filters": {
                    "test": "is_game_rule",
                    "domain": "showDeathMessages",
                    "value": true
                },
                "queue_command": {
                    "command": [
                        "gamerule showdeathmessages false",
                        "kill @s",
                        "gamerule showdeathmessages true"
                    ]
                }
            }
        ]
      },
      "ds:disappear": {
        "add": {
         "component_groups": [
         "ds:disappear"
         ]
        }
      }
    }
  }
}